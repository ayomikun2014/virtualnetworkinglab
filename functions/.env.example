# VirtuaNetLab Cloud Functions — example environment file.
#
# Copy this to `functions/.env` and fill in the real value. The Firebase CLI
# reads `functions/.env` at deploy time and bakes the variables into the
# deployed function's environment.
#
# `.env` is gitignored; `.env.example` is not. Never put the HMAC secret in
# either of them — that one goes in Secret Manager (see below).

# ---------------------------------------------------------------------------
# FASTAPI_ENGINE_URL — the Cloud Run service URL of the Python engine.
#
# You only know this value AFTER the first Cloud Run deploy, so the order is:
#   1. deploy the engine to Cloud Run
#   2. copy the https://... URL it prints
#   3. paste it below (no trailing slash, no /api/v1/simulate suffix)
#   4. firebase deploy --only functions
#
# Leave it unset for local emulator work and it falls back to
# http://localhost:8080. A DEPLOYED function will throw a clear error rather
# than time out if this is still unset — see functions/src/config/env.ts.
# ---------------------------------------------------------------------------
FASTAPI_ENGINE_URL=https://virtuanetlab-engine-xxxxxxxxxx-nw.a.run.app

# ---------------------------------------------------------------------------
# HMAC_SECRET_KEY is NOT set here.
#
# It is a Secret Manager secret, declared in code via defineSecret(). Set it
# once with:
#   firebase functions:secrets:set HMAC_SECRET_KEY
#
# The identical value must be set on the Cloud Run service, or the engine
# returns 401 on every request.
# ---------------------------------------------------------------------------

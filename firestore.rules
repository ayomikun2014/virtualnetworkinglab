rules_version = '2';

// ============================================================================
// VirtuaNetLab — OPEN ACCESS Firestore rules (school-project mode).
//
// DELIBERATELY UNRESTRICTED. Read this before changing anything.
//
// WHY
// This deployment is a university coursework demo used by a small, known group
// of students and staff. It is not a public site. The previous rule set was
// deny-by-default with per-role and per-owner checks, and it kept getting in
// the way during testing: a student could not read another student's canvas
// for a demo, the admin seeding path was blocked, and progress documents were
// server-write-only so nothing could be fixed up by hand.
//
// The hardened rule set has NOT been deleted. It lives in
// `firestore.rules.production`, fully commented. If this app is ever exposed
// beyond the test group, restoring it is a file copy:
//
//     copy firestore.rules.production firestore.rules
//     firebase deploy --only firestore:rules
//
// WHAT THIS COSTS YOU — be honest about this in the write-up
// With these rules, a student who opens the browser console can:
//   * write their own `student_progress` document and mark every level passed
//     without building a single topology,
//   * change their own `role` to `admin` and open every staff screen,
//   * read the `exercises/{id}/private/**` solution keys,
//   * read and overwrite any other student's topology.
// None of that matters for a marked demo where nobody is competing, but it
// does mean the grader's output is not trustworthy as an assessment record.
// The server-side enforcement still exists and still works — it is just not
// switched on here.
//
// WHAT IS STILL SAFE
// The HMAC signature on the simulation engine is unaffected by this file. The
// Cloud Function is still the only dispatcher, and it still signs every
// request, so nobody can drive the Cloud Run engine directly.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything, for everyone, signed in or not. Matches the "allow all"
    // setting already applied in the Firebase console, so the console and this
    // file no longer disagree.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

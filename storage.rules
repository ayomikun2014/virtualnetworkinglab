rules_version = '2';

// ============================================================================
// VirtuaNetLab — OPEN ACCESS Cloud Storage rules (school-project mode).
//
// DELIBERATELY UNRESTRICTED, for the same reasons as firestore.rules. See the
// header of that file for the full rationale and the list of what this gives
// up.
//
// The hardened version — owner-scoped paths, staff-only content uploads, image
// content-type checks and 5/10/20 MB size caps — is preserved in
// `storage.rules.production`. To restore:
//
//     copy storage.rules.production storage.rules
//     firebase deploy --only storage
//
// ONE PRACTICAL NOTE
// The size caps are gone along with everything else, so there is nothing here
// stopping a large upload from running up the bucket's bill. With a handful of
// known students that is not a real risk, but keep an eye on the Storage usage
// tab if you leave the project deployed after the demo.
//
// The simulation engine writes its artifacts (summary.json, stdout.log,
// stderr.log, packet_stream.json) with the Admin SDK, which bypasses these
// rules either way, so opening this file up was not required for the engine to
// work — it only affects browser-side access.
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}

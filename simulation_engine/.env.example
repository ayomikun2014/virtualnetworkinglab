# VirtuaNetLab simulation engine — example environment file.
#
# Copy to `.env` and fill in real values. `.env` itself is gitignored and must
# never be committed.

# Shared HMAC secret. MUST match the HMAC_SECRET_KEY the Cloud Function signs
# with, and MUST NOT be the old published default
# ("vnl-default-secret-key-change-in-production"). The engine refuses to start
# in production if it is unset or still that value.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HMAC_SECRET_KEY=

FIREBASE_STORAGE_BUCKET=your-project.appspot.com
PORT=8080
ENV=development

# Path to the service-account JSON. Keep the file OUTSIDE the repository.
# On Cloud Run, prefer the runtime service account and leave this unset.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json

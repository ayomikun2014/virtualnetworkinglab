# Files NOT uploaded to Cloud Build by `gcloud run deploy --source .`
#
# Without this, the whole directory — including `.env`, the service-account
# JSON and the local `venv/` — is uploaded to a Cloud Storage staging bucket
# before the build even starts. That is a second copy of the secrets in a
# place nobody thinks to look at.
#
# Note: gcloud does NOT read .dockerignore, and Docker does NOT read
# .gcloudignore, so both files have to exist and stay in sync.

.env
.env.*
!.env.example
*serviceAccount*.json
*firebase-adminsdk*.json
backend-testing-*.json

venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

*.log
.DS_Store
.git/
.gitignore
